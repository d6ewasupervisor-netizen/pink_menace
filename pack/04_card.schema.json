{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactag.app/schemas/pink-menace/card.schema.json",
  "title": "Pink Menace Card",
  "type": "object",
  "required": [
    "card_id", "act", "zone", "driver", "card_type", "title", "hook",
    "scene", "source", "image_brief", "variation"
  ],
  "additionalProperties": false,
  "properties": {
    "card_id": {
      "type": "string",
      "pattern": "^(I|II|III|IV|V|VI|VII)-[0-9]{3}$",
      "description": "Act numeral, dash, zero-padded sequence. e.g. II-014"
    },
    "act": { "enum": ["I", "II", "III", "IV", "V", "VI", "VII"] },
    "zone": {
      "enum": ["The Lot", "The Grid", "Central", "The Core", "The Ribbon", "The Backcountry", "The Dark Hours"]
    },
    "driver": { "enum": ["ali", "deac", "yuna"] },
    "card_type": {
      "enum": ["scene", "hazard", "rule", "convoy", "wrench", "ledger", "dossier"]
    },
    "title": { "type": "string", "minLength": 3, "maxLength": 40 },
    "hook": {
      "type": "string",
      "minLength": 8,
      "maxLength": 90,
      "description": "One present-tense line, ≤12 words. The situation. Default display with the image and options; full scene sits behind a tap on this line."
    },
    "scene": { "type": "string", "minLength": 150, "maxLength": 700 },
    "decision": {
      "type": "string",
      "maxLength": 200,
      "description": "Required for all types except dossier."
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "description": "Omitted for dossier cards.",
      "items": {
        "type": "object",
        "required": ["id", "text", "correct", "result", "state_delta"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-d]$" },
          "text": { "type": "string", "maxLength": 160 },
          "correct": { "type": "boolean" },
          "result": { "type": "string", "minLength": 80, "maxLength": 400 },
          "state_delta": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "noise": { "type": "integer", "minimum": -3, "maximum": 5 },
              "light": { "type": "integer", "minimum": -3, "maximum": 5 },
              "yaw": { "type": "integer", "minimum": -3, "maximum": 5 },
              "fuel": { "type": "integer", "minimum": -5, "maximum": 2 },
              "passenger_stress": { "type": "integer", "minimum": -3, "maximum": 5 },
              "time_cost": { "type": "integer", "minimum": 0, "maximum": 60 },
              "damage": { "type": "integer", "minimum": 0, "maximum": 5 },
              "fatal": { "type": "boolean" }
            }
          }
        }
      }
    },
    "debrief": { "type": "string", "maxLength": 400 },
    "source": {
      "type": "object",
      "required": ["psdp_skill", "dol_section", "teaching_target"],
      "additionalProperties": false,
      "properties": {
        "psdp_skill": {
          "type": "string",
          "description": "Exact heading from pack/08_PSDP_SKILLS.json (verbatim from the WA Parent's Supervised Driving Program), or 'n/a'. Never invent or complete a subtitle."
        },
        "dol_section": {
          "type": "string",
          "description": "Exact numbered heading from pack/07_DOL_SECTIONS.json (WA Driver Guide body, not a TOC regex), e.g. '4.2 Sharing with school buses'."
        },
        "teaching_target": { "type": "string", "maxLength": 200 },
        "stat_cited": {
          "type": "string",
          "description": "Optional. Verbatim figure from PSDP or DOL, and it must include a page number (e.g. 'PSDP p.12'). Omit the field if you cannot cite a page — never ship a number without one."
        }
      }
    },
    "cast": {
      "type": "array",
      "items": {
        "enum": [
          "ali", "deac", "yuna", "gracie", "mya",
          "reyna_solis", "bus_12", "tobin", "marisol", "hollis",
          "grange_convoy", "old_ninety", "officer_dunn", "gravy",
          "ferry_line", "the_crossing"
        ]
      }
    },
    "antagonist": {
      "enum": ["splitter", "chorus", "load", "ejection", "dark_hours", "drift", "cold_roads", "none"]
    },
    "callback_of": {
      "type": ["string", "null"],
      "description": "card_id this ledger card resolves. Null unless card_type is 'ledger'."
    },
    "schedules_callback": {
      "type": "boolean",
      "description": "True if a wrong answer here should queue a ledger card later in this act."
    },
    "timeout_option_id": {
      "type": "string",
      "pattern": "^[a-d]$",
      "description": "Required on hazard cards. The option the world takes if the timed window closes."
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 4000,
      "maximum": 30000,
      "description": "Hazard decision window. Default 24000."
    },
    "image_brief": {
      "type": "object",
      "required": ["camera", "subject", "foreground", "midground", "background", "read"],
      "additionalProperties": false,
      "properties": {
        "camera": {
          "enum": [
            "POV_COCKPIT",
            "POV_MIRROR_REAR",
            "POV_MIRROR_DOOR",
            "POV_TOPDOWN_PHOTO",
            "POV_DIAGRAM",
            "POV_CHASE",
            "POV_ROADSIDE",
            "POV_PORTRAIT",
            "POV_OBJECT"
          ],
          "description": "POV_TOPDOWN and POV_MIRROR are illegal. Photoreal aerials are POV_TOPDOWN_PHOTO (establishing only). Lane law uses POV_DIAGRAM. Following traffic uses POV_MIRROR_REAR only when the ego has a rear window; on the Ledger (driver deac) following traffic uses POV_MIRROR_DOOR. Blind zones use POV_MIRROR_DOOR."
        },
        "camera_is_the_lesson": {
          "type": "boolean",
          "description": "True when the camera position is itself the teaching content. Exempt from the 25% act cap and from window-of-6 token counts; consecutive-token rule still applies."
        },
        "subject": { "type": "string", "maxLength": 200 },
        "foreground": { "type": "string", "maxLength": 200 },
        "midground": { "type": "string", "maxLength": 200 },
        "background": { "type": "string", "maxLength": 200 },
        "read": {
          "type": "string",
          "maxLength": 250,
          "description": "The single visual fact that teaches the card with the text muted."
        },
        "continuity": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Canonical bible assets that must render exactly. POV_DIAGRAM attaches the ego vehicle lock (pink_menace_exterior for Ali, the_ledger for Deac). Never attach a Menace lock on a Deac card. No faces."
        },
        "aspect": { "enum": ["2:3", "16:9", "1:1"], "default": "2:3" },
        "geometry": {
          "type": "object",
          "description": "Required whenever a roadway appears in frame. The plow is the orientation anchor.",
          "required": [
            "ego_heading",
            "ego_lane_side",
            "ego_nose_in_frame",
            "oncoming_position",
            "hazard_position"
          ],
          "additionalProperties": false,
          "properties": {
            "ego_heading": {
              "enum": ["away_from_camera", "toward_camera", "left_to_right", "right_to_left"]
            },
            "ego_lane_side": { "type": "string", "minLength": 8, "maxLength": 120 },
            "ego_nose_in_frame": { "type": "string", "minLength": 8, "maxLength": 160 },
            "oncoming_position": { "type": "string", "minLength": 4, "maxLength": 160 },
            "hazard_position": {
              "enum": ["ahead_same_direction", "behind", "oncoming", "beside", "none"]
            },
            "traffic_positions": {
              "type": "array",
              "description": "Required on Deac POV_DIAGRAM and POV_ROADSIDE when a same-direction vehicle is in frame. Passing is on the LEFT. Each entry is one other same-direction vehicle.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["vehicle", "lane", "along", "lengths"],
                "properties": {
                  "vehicle": { "type": "string", "minLength": 2, "maxLength": 80 },
                  "lane": { "enum": ["left_of_ego", "right_of_ego", "same_as_ego"] },
                  "along": { "enum": ["ahead", "beside", "behind"] },
                  "lengths": { "type": "number", "minimum": 0, "maximum": 20 }
                }
              }
            }
          }
        }
      }
    },
    "variation": {
      "type": "object",
      "required": ["location_type", "weather", "time_of_day", "tone", "failure_mode"],
      "additionalProperties": false,
      "properties": {
        "location_type": {
          "enum": ["parking_lot", "residential", "arterial", "downtown", "highway", "rural", "gravel", "mountain_pass", "waterfront", "rail_crossing", "work_zone", "school_zone"]
        },
        "weather": { "enum": ["overcast", "rain", "heavy_rain", "fog", "snow", "ice", "clear_cold", "wind"] },
        "time_of_day": { "enum": ["dawn", "morning", "midday", "afternoon", "dusk", "night", "deep_night"] },
        "tone": { "enum": ["procedural", "tense", "quiet", "wry", "grim", "warm", "urgent"] },
        "failure_mode": {
          "enum": ["speed", "distraction", "passengers", "belt", "night", "fatigue", "inexperience", "impairment", "vehicle_failure", "weather", "none"]
        },
        "forced": {
          "type": "string",
          "description": "If an axis had to repeat, name it and why."
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "card_type": { "const": "dossier" } } },
      "then": { "not": { "required": ["options"] } },
      "else": { "required": ["decision", "options", "debrief"] }
    },
    {
      "if": { "properties": { "card_type": { "const": "hazard" } } },
      "then": { "required": ["timeout_option_id"] }
    }
  ]
}
