{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactag.app/schemas/pink-menace/card.schema.json",
  "title": "Pink Menace Card",
  "type": "object",
  "required": [
    "card_id", "act", "zone", "driver", "card_type", "title", "hook",
    "scene", "source", "image_brief", "variation"
  ],
  "additionalProperties": false,
  "properties": {
    "card_id": {
      "type": "string",
      "pattern": "^(I|II|III|IV|V|VI|VII)-[0-9]{3}$",
      "description": "Act numeral, dash, zero-padded sequence. e.g. II-014"
    },
    "act": { "enum": ["I", "II", "III", "IV", "V", "VI", "VII"] },
    "zone": {
      "enum": ["The Lot", "The Grid", "Central", "The Core", "The Ribbon", "The Backcountry", "The Dark Hours"]
    },
    "driver": { "enum": ["ali", "deac", "yuna"] },
    "card_type": {
      "enum": ["scene", "hazard", "rule", "convoy", "wrench", "ledger", "dossier", "ride-along", "beat"]
    },
    "title": { "type": "string", "minLength": 3, "maxLength": 40 },
    "hook": {
      "type": "string",
      "minLength": 8,
      "maxLength": 90,
      "description": "One present-tense line, ≤12 words. The situation. Default display with the image and options; full scene sits behind a tap on this line."
    },
    "scene": { "type": "string", "minLength": 150, "maxLength": 700 },
    "decision": {
      "type": "string",
      "maxLength": 200,
      "description": "Required for all types except dossier, ride-along, and no-question ledger callbacks."
    },
    "debrief": {
      "type": "string",
      "maxLength": 400,
      "description": "Teaching line after the card. Required except empty dossier debriefs."
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "description": "Omitted for dossier cards and no-question ledger callbacks.",
      "items": {
        "type": "object",
        "required": ["id", "text", "correct", "result", "state_delta"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-d]$" },
          "text": { "type": "string", "maxLength": 160 },
          "correct": { "type": "boolean" },
          "result": { "type": "string", "minLength": 80, "maxLength": 400 },
          "state_delta": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "noise": { "type": "integer", "minimum": -3, "maximum": 5 },
              "light": { "type": "integer", "minimum": -3, "maximum": 5 },
              "yaw": { "type": "integer", "minimum": -3, "maximum": 5 },
              "fuel": { "type": "integer", "minimum": -5, "maximum": 2 },
              "passenger_stress": { "type": "integer", "minimum": -3, "maximum": 5 },
              "time_cost": { "type": "integer", "minimum": 0, "maximum": 60 },
              "damage": { "type": "integer", "minimum": 0, "maximum": 5 },
              "fatal": { "type": "boolean" }
            }
          }
        }
      }
    },
    "ride_along": {
      "type": "array",
      "minItems": 12,
      "maxItems": 15,
      "items": { "type": "string", "minLength": 8, "maxLength": 160 },
      "description": "Watch-layer lines. Deac drives; tap advances. Required on ride-along cards."
    },
    "ride_beats": {
      "type": "array",
      "minItems": 12,
      "maxItems": 15,
      "description": "Per-line look and tap for ride-along. Length must match ride_along. look pans the still; tap is the hotspot she must hit (sweep/eyes are sequences).",
      "items": {
        "type": "object",
        "required": ["look", "tap"],
        "additionalProperties": false,
        "properties": {
          "look": {
            "enum": ["road", "left", "right", "gap", "thermos", "wheel"]
          },
          "tap": {
            "enum": ["anywhere", "left", "right", "gap", "thermos", "wheel", "sweep", "eyes"]
          },
          "still": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,24}$",
            "description": "Optional beat still under /ride/<card_id>/<still>.webp. Omit to keep the live card image."
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["psdp_skill", "dol_section", "teaching_target"],
      "additionalProperties": false,
      "properties": {
        "psdp_skill": {
          "type": "string",
          "description": "Exact heading from pack/08_PSDP_SKILLS.json (verbatim from the WA Parent's Supervised Driving Program), or 'n/a'. Never invent or complete a subtitle."
        },
        "dol_section": {
          "type": ["string", "null"],
          "description": "Exact numbered heading from pack/07_DOL_SECTIONS.json (WA Driver Guide body, not a TOC regex), e.g. '4.2 Sharing with school buses'. Null or 'n/a' when DOL has no heading (PSDP-only lessons). Do not mint a missing section."
        },
        "teaching_target": { "type": "string", "maxLength": 200 },
        "stat_cited": {
          "type": "string",
          "description": "Optional. Verbatim figure from PSDP or DOL, and it must include a page number (e.g. 'PSDP p.12'). Omit the field if you cannot cite a page — never ship a number without one."
        }
      }
    },
    "cast": {
      "type": "array",
      "items": {
        "enum": [
          "ali", "deac", "yuna", "gracie", "mya",
          "reyna_solis", "bus_12", "tobin", "marisol", "hollis",
          "grange_convoy", "old_ninety", "officer_dunn", "gravy",
          "ferry_line", "the_crossing"
        ]
      }
    },
    "antagonist": {
      "enum": ["splitter", "chorus", "load", "ejection", "dark_hours", "drift", "cold_roads", "none"]
    },
    "callback_of": {
      "type": ["string", "null"],
      "description": "card_id this ledger card resolves. Null unless card_type is 'ledger'."
    },
    "schedules_callback": {
      "type": "boolean",
      "description": "True if a wrong answer here should queue a ledger card later in this act."
    },
    "presence": {
      "type": "integer",
      "minimum": 0,
      "description": "Canonical Quiet presence on this card. Do not invent a parallel live field (no load_state). 0 unless the Quiet is in the situation."
    },
    "timeout_option_id": {
      "type": "string",
      "pattern": "^[a-d]$",
      "description": "Required on hazard cards. The option the world takes if the timed window closes."
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 4000,
      "maximum": 30000,
      "description": "Hazard decision window. Default 24000. Also used on beat cards."
    },
    "tone_debrief": {
      "type": "string",
      "maxLength": 700,
      "description": "Deprecated. I-009 uses lot_states."
    },
    "lot_states": {
      "type": "object",
      "additionalProperties": false,
      "description": "I-009 stop-line and debrief by what she did on I-007. called = a, correct = b, slow = c or d.",
      "properties": {
        "called": { "$ref": "#/$defs/lotState" },
        "correct": { "$ref": "#/$defs/lotState" },
        "slow": { "$ref": "#/$defs/lotState" }
      }
    },
    "image_brief": {
      "type": "object",
      "required": ["camera", "subject", "foreground", "midground", "background", "read"],
      "additionalProperties": false,
      "properties": {
        "camera": {
          "enum": [
            "POV_COCKPIT",
            "POV_MIRROR_REAR",
            "POV_MIRROR_DOOR",
            "POV_TOPDOWN_PHOTO",
            "POV_DIAGRAM",
            "POV_CHASE",
            "POV_ROADSIDE",
            "POV_ROADSIDE_PROFILE",
            "POV_PORTRAIT",
            "POV_OBJECT"
          ],
          "description": "POV_TOPDOWN and POV_MIRROR are illegal. Photoreal aerials are POV_TOPDOWN_PHOTO (establishing only). Lane law uses POV_DIAGRAM. Following traffic uses POV_MIRROR_REAR only when the ego has a rear window; on the Ledger (driver deac) following traffic uses POV_MIRROR_DOOR. Blind zones use POV_MIRROR_DOOR."
        },
        "camera_is_the_lesson": {
          "type": "boolean",
          "description": "True when the camera position is itself the teaching content. Exempt from the 25% act cap, from window-of-6 token counts, and from consecutive-token when either card in the pair is lesson or ego-seat (POV_COCKPIT / POV_MIRROR_DOOR)."
        },
        "extra_negatives": {
          "type": "array",
          "items": { "type": "string", "minLength": 4, "maxLength": 160 },
          "description": "Appended to the compiled negative block. Use for inverse marking placements and reference-photo leaks."
        },
        "subject": { "type": "string", "maxLength": 200 },
        "foreground": { "type": "string", "maxLength": 200 },
        "midground": { "type": "string", "maxLength": 200 },
        "background": { "type": "string", "maxLength": 200 },
        "read": {
          "type": "string",
          "maxLength": 250,
          "description": "The single visual fact that teaches the card with the text muted."
        },
        "continuity": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Canonical bible assets that must render exactly. POV_DIAGRAM attaches the ego vehicle lock (pink_menace_exterior for Ali, the_ledger for Deac). Never attach a Menace lock on a Deac card. No faces. Any frame with the Quiet includes the_quiet — attaches ref_quiet.png."
        },
        "aspect": { "enum": ["2:3", "16:9", "1:1"], "default": "2:3" },
        "geometry": {
          "type": "object",
          "description": "Required whenever a roadway appears in frame. The plow is the orientation anchor.",
          "required": [
            "ego_heading",
            "ego_lane_side",
            "ego_nose_in_frame",
            "oncoming_position",
            "hazard_position"
          ],
          "additionalProperties": false,
          "properties": {
            "ego_heading": {
              "enum": ["away_from_camera", "toward_camera", "left_to_right", "right_to_left"]
            },
            "ego_lane_side": { "type": "string", "minLength": 8, "maxLength": 120 },
            "ego_nose_in_frame": { "type": "string", "minLength": 8, "maxLength": 160 },
            "oncoming_position": { "type": "string", "minLength": 4, "maxLength": 160 },
            "hazard_position": {
              "enum": ["ahead_same_direction", "behind", "oncoming", "beside", "none"]
            },
            "lanes_this_direction": {
              "type": "number",
              "minimum": 1,
              "maximum": 8,
              "description": "Travel lanes in ego's direction. Required on Deac diagram/roadside with same-direction traffic. Replaces 'right half of the roadway' on multi-lane."
            },
            "ego_lane_from_left": {
              "type": "number",
              "minimum": 1,
              "maximum": 8,
              "description": "Which of those lanes the ego occupies, counting from the left. 1 = leftmost."
            },
            "ego_frame_side": {
              "enum": ["left", "right"],
              "description": "Required when ego_heading is away_from_camera. Left/right of the FRAME, not of ego."
            },
            "marking_anchor": {
              "type": "object",
              "additionalProperties": false,
              "required": ["edge", "marking", "ego_relative"],
              "description": "Required when the card's read is a pavement marking or lane line. Name the roadway edge, then the marking relative to it, then ego relative to the marking.",
              "properties": {
                "edge": { "type": "string", "minLength": 4, "maxLength": 120 },
                "marking": { "type": "string", "minLength": 4, "maxLength": 160 },
                "ego_relative": { "type": "string", "minLength": 8, "maxLength": 200 }
              }
            },
            "traffic_positions": {
              "type": "array",
              "description": "Required on Deac POV_DIAGRAM, POV_ROADSIDE, and POV_CHASE when a same-direction vehicle is in frame. Prefer frame_side (left/right of FRAME, or same for the shuttle's lane with the opposite half empty) over role-relative lane. Do not compile 'passing occurs on the LEFT'.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["vehicle", "along", "lengths"],
                "properties": {
                  "vehicle": { "type": "string", "minLength": 2, "maxLength": 80 },
                  "frame_side": { "enum": ["left", "right", "same"] },
                  "lane_from_left": { "type": "number", "minimum": 1, "maximum": 8 },
                  "lane": { "enum": ["left_of_ego", "right_of_ego", "same_as_ego"] },
                  "along": { "enum": ["ahead", "beside", "behind"] },
                  "lengths": { "type": "number", "minimum": 0, "maximum": 20 }
                }
              }
            }
          }
        }
      }
    },
    "variation": {
      "type": "object",
      "required": ["location_type", "weather", "time_of_day", "tone", "failure_mode"],
      "additionalProperties": false,
      "properties": {
        "location_type": {
          "enum": ["parking_lot", "residential", "arterial", "downtown", "highway", "rural", "gravel", "mountain_pass", "waterfront", "rail_crossing", "work_zone", "school_zone"]
        },
        "weather": { "enum": ["overcast", "rain", "heavy_rain", "fog", "snow", "ice", "clear_cold", "wind"] },
        "time_of_day": { "enum": ["dawn", "morning", "midday", "afternoon", "dusk", "night", "deep_night"] },
        "tone": { "enum": ["procedural", "tense", "quiet", "wry", "grim", "warm", "urgent"] },
        "failure_mode": {
          "enum": ["speed", "distraction", "passengers", "belt", "night", "fatigue", "inexperience", "impairment", "vehicle_failure", "weather", "none"]
        },
        "forced": {
          "type": "string",
          "description": "If an axis had to repeat, name it and why. After a PASS seed, points at the live take and names any discarded runner-up."
        },
        "winner": {
          "type": "string",
          "description": "Seeded live take id (e.g. take-21). Optional until a muted-read PASS is locked."
        }
      }
    }
  },
  "$defs": {
    "lotState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stop", "debrief"],
      "properties": {
        "stop": { "type": "string", "minLength": 8, "maxLength": 120 },
        "debrief": { "type": "string", "minLength": 20, "maxLength": 400 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "card_type": { "enum": ["dossier", "ride-along"] } } },
      "then": { "not": { "required": ["options"] } },
      "else": {
        "if": {
          "properties": { "card_type": { "const": "ledger" } },
          "required": ["callback_of"],
          "not": { "required": ["decision"] }
        },
        "then": {
          "required": ["debrief", "callback_of"],
          "not": { "required": ["options"] }
        },
        "else": { "required": ["decision", "options", "debrief"] }
      }
    },
    {
      "if": { "properties": { "card_type": { "const": "ride-along" } } },
      "then": { "required": ["ride_along", "debrief"] }
    },
    {
      "if": { "properties": { "card_type": { "const": "hazard" } } },
      "then": { "required": ["timeout_option_id"] }
    }
  ]
}
