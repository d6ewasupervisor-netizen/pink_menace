          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Cargo's loaded. My truck, not yours — the Ledger. No back window, so the mirrors are your whole world back there.",
          "next": "2.5.card_III-002"
        },
        "2.5.card_III-002": {
          "type": "card",
          "card": "III-002",
          "next": "2.5.1"
        },
        "2.5.1": {
          "type": "line",
          "speaker": "DEAC",
          "delivery": "S",
          "emotion": "neutral",
          "volume": "low",
          "text": "Central's three lanes. Right lane is for moving. Left is for passing, not for living.",
          "next": "2.5.card_III-003"
        },
        "2.5.card_III-003": {
          "type": "card",
          "card": "III-003",
          "next": "2.5.2"
        },
        "2.5.2": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "SYS",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "Sweep the mirror, then the shoulder, before the wheel moves. Signal early enough to matter.",
          "next": "2.5.card_III-004"
        },
        "2.5.card_III-004": {
          "type": "card",
          "card": "III-004",
          "next": "2.5.card_III-006"
