          "delivery": "SYS",
          "emotion": "neutral",
          "volume": "whisper",
          "text": "The lines out here aren't lane lines — the edge is a drop-off. Stay off it.",
          "next": "6.1b.card_VI-002"
        },
        "6.1b.card_VI-002": {
