        "6.1b.shoulder": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "SYS",
          "emotion": "tense",
          "volume": "whisper",
          "text": "Off the edge. Let the road come back. Don't yank."
        },
        "6.1b.yank": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "panicked",
          "volume": "whisper",
          "auto_ms": 2400,
          "text": "Yanked it. Off the edge you hold the line — you don't jerk back.",
          "effects": {
            "respect": -2,
            "log": "rural.shoulder.yank"
          }
        },
        "6.1b.crest_fast": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "tense",
          "volume": "whisper",
          "auto_ms": 2600,
          "text": "Blind crest, too fast. You can't see over the top until you're on it.",
          "effects": {
            "respect": -1,
            "log": "rural.crest.fast"
          }
        },
        "6.1b.crest_clean": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "calm",
          "volume": "whisper",
          "auto_ms": 2400,
          "text": "Slow over the top. Good.",
          "effects": {
            "respect": 1,
            "log": "rural.crest.clean"
          }
        },
        "6.1b.uncontr_rolled": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "tense",
          "volume": "whisper",
          "auto_ms": 2600,
          "text": "Rolled right through. Nobody's in charge here — which means it's on you.",
          "effects": {
            "respect": -2,
            "log": "rural.uncontrolled.rolled"
          }
        },
        "6.1b.uncontr_yield": {
          "type": "line",
          "speaker": "ALI",
          "delivery": "G",
          "emotion": "calm",
          "volume": "whisper",
          "auto_ms": 2400,
          "text": "Slowed, looked, waited. That's the whole rule out here.",
          "effects": {
            "respect": 2,
            "log": "rural.uncontrolled.yield"
